# ==============================================================================
# EchoSphere Environment Variables Template
# Copy this file to .env.local for local development, or configure in Vercel / Railway.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & WebSocket URLs (Optional on localhost, Required for decoupled deployments)
# ------------------------------------------------------------------------------
# On localhost or unified fullstack Vercel: Leave blank for automatic relative /api routing.
# On decoupled frontend (Vercel) pointing to Railway backend: Set to your Railway backend URL.
NEXT_PUBLIC_API_URL=https://echosphere-backend.up.railway.app

# WebSocket transport URL (defaults to wss:// current host if omitted)
NEXT_PUBLIC_WS_URL=wss://echosphere-backend.up.railway.app

# ------------------------------------------------------------------------------
# 2. Agora RTC & Conversational AI Credentials (Required)
# ------------------------------------------------------------------------------
# Found in Agora Console (https://console.agora.io/) → Projects → App ID
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_ID=

# Found in Agora Console → Projects → App Certificate (SERVER-SIDE ONLY)
# Never expose the App Certificate in client bundles.
AGORA_APP_CERTIFICATE=
NEXT_AGORA_APP_CERTIFICATE=

# ------------------------------------------------------------------------------
# 3. Backend CORS Configuration (Used by Railway / Backend API)
# ------------------------------------------------------------------------------
# Frontend domain permitted to make cross-origin requests to this backend.
# (localhost:3000 is always whitelisted automatically).
CORS_ALLOWED_ORIGIN=https://echosphere.vercel.app
FRONTEND_URL=https://echosphere.vercel.app

# ------------------------------------------------------------------------------
# 4. Clerk Authentication (Optional / Pre-configured)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------------------------
# 5. Convex Real-Time Cloud Backend (Optional / Pre-configured)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
