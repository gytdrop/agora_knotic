# ==============================================================================
# EchoSphere Environment Variables Template (.env.local)
# ==============================================================================

# Agora credentials (Required)
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_ID=

# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=
AGORA_APP_CERTIFICATE=

# Optional API / WebSocket overrides (Leave blank for relative routing on localhost)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Backend CORS Allowed Origin
CORS_ALLOWED_ORIGIN=
